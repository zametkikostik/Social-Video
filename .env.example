# ======================
# Social-Video Environment
# ======================

# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://socialvideo:socialvideo@localhost:5432/socialvideo?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-very-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Cloudflare R2 (production storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=social-video
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Local MinIO (development)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=social-video
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Upload limits
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_MIME=video/mp4,video/webm,video/quicktime,video/x-msvideo

# Transcoding
FFMPEG_PATH=ffmpeg
TRANSCODE_QUALITIES=1080p,720p,480p,360p
HLS_SEGMENT_DURATION=6

# Live (позже)
LIVE_RTMP_URL=rtmp://localhost:1935/live

# AI Moderation
# OpenAI Moderation API (recommended). If empty — local keyword heuristic is used.
OPENAI_API_KEY=
# Score threshold (0.0–1.0). Above this → quarantine for regular users.
MODERATION_THRESHOLD=0.7
