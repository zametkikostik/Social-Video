API_URL=https://video.example.com
AP_BASE_URL=https://video.example.com
NEXT_PUBLIC_API_URL=https://video.example.com/api
NEXT_PUBLIC_WS_URL=https://video.example.com

NODE_ENV=production
PORT=4000

JWT_SECRET=
JWT_EXPIRES_IN=7d

POSTGRES_USER=socialvideo
POSTGRES_PASSWORD=
POSTGRES_DB=socialvideo

