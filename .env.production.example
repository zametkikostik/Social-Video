RUN_SEED=false
AP_REQUIRE_SIGNATURE=true

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
UPLOAD_MAX_MB=2048

WEB3_DEFAULT_CHAIN=137
WEB3_TREASURY_ADDRESS=
WEB3_RPC_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
YOOMONEY_WALLET=
YOOMONEY_SECRET=
